{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "strategy": "DualHorizonTrendV2",
  "timeframe": "1h",
  "dataformat_ohlcv": "json",
  "trading_mode": "spot",
  "margin_mode": "",
  "max_open_trades": 2,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "dry_run": true,
  "dry_run_wallet": 10000,
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "fetchMarkets": {
          "types": [
            "spot"
          ]
        }
      },
      "urls": {
        "api": {
          "public": "https://data-api.binance.vision/api/v3"
        }
      }
    },
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "bot_name": "dual-horizon-share",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  },
  "fee": 0.001
}